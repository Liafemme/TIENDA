{%- comment -%}
  Sugerencias en el carrito: productos de una colección (por defecto "Lo más deseado"),
  sin repetir los que ya están en el carrito y solo si están disponibles.
  Se añaden sin salir del carrito con assets/lf-cart-upsell.js (mismo evento que el formulario de
  producto del tema), así el carrito, la barra de tramos y el total se actualizan solos.
  - collection: handle de la colección (por defecto 'lo-mas-deseado')
  - limit: número máximo de sugerencias (por defecto 6)
  - heading: título (por defecto 'Completa tu look')
{%- endcomment -%}
{%- liquid
  assign handle = collection | default: 'lo-mas-deseado'
  assign max = limit | default: 6
  assign source = collections[handle]
  assign in_cart = cart.items | map: 'product_id'
  assign shown = 0
-%}
{%- if source and source.products.size > 0 -%}
  {%- capture cards -%}
    {%- for p in source.products -%}
      {%- if shown >= max -%}{%- break -%}{%- endif -%}
      {%- if p.available == false or in_cart contains p.id -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      <li class="lf-upsell__card">
        <a href="{{ p.url }}" class="lf-upsell__media" tabindex="-1" aria-hidden="true">
          {%- if p.featured_image -%}
            {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', sizes: '140px', alt: '' }}
          {%- endif -%}
        </a>
        <a href="{{ p.url }}" class="lf-upsell__title">{{ p.title }}</a>
        <p class="lf-upsell__price">
          <span{% if p.compare_at_price > p.price %} class="is-sale"{% endif %}>{{ p.price | money }}</span>
          {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
        </p>
        {%- if p.has_only_default_variant -%}
          <button type="button" class="lf-upsell__add" data-lf-upsell-add data-variant-id="{{ v.id }}">Añadir</button>
        {%- else -%}
          <select class="lf-upsell__select" aria-label="{{ p.options.first | escape }} de {{ p.title | escape }}">
            {%- for variant in p.variants -%}
              {%- if variant.available -%}<option value="{{ variant.id }}">{{ variant.title }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
          <button type="button" class="lf-upsell__add" data-lf-upsell-add>Añadir</button>
        {%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if shown > 0 -%}
    <div class="lf-upsell">
      <p class="lf-upsell__heading">{{ heading | default: 'Completa tu look' }}</p>
      <ul class="lf-upsell__track" role="list">{{ cards }}</ul>
    </div>
  {%- endif -%}
{%- endif -%}


{% stylesheet %}
  .lf-upsell{width:100%;display:grid;gap:10px;color:var(--lf-ink,#1e1a17)}
  .lf-upsell__heading{margin:0;font-family:var(--font-heading--family);font-size:18px;line-height:1.2}
  .lf-upsell__track{display:grid;grid-auto-flow:column;grid-auto-columns:140px;gap:10px;margin:0;padding:0 0 6px;list-style:none;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
  .lf-upsell__card{scroll-snap-align:start;display:flex;flex-direction:column;gap:6px;font-size:12px;line-height:1.3}
  .lf-upsell__media{display:block;aspect-ratio:3/4;border-radius:6px;overflow:hidden;background:var(--lf-soft,#f3ede5)}
  .lf-upsell__media img{width:100%;height:100%;object-fit:cover;display:block;mix-blend-mode:multiply}
  .lf-upsell__title{color:inherit;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.6em}
  .lf-upsell__price{margin:0;display:flex;gap:6px;align-items:baseline;font-weight:600}
  .lf-upsell__price .is-sale{color:var(--lf-sale,#a23b2c)}
  .lf-upsell__price s{font-weight:400;color:var(--lf-muted,#6b625a)}
  .lf-upsell__select{width:100%;min-height:32px;padding:4px 6px;border:1px solid var(--lf-line,#e7dfd5);border-radius:6px;background:#fff;font-size:12px;color:inherit}
  .lf-upsell__add{min-height:34px;border:1px solid var(--lf-ink,#1e1a17);border-radius:999px;background:transparent;color:var(--lf-ink,#1e1a17);font-size:12px;font-weight:600;letter-spacing:.04em;cursor:pointer}
  .lf-upsell__add:hover{background:var(--lf-ink,#1e1a17);color:#fff}
  .lf-upsell__add.is-loading{opacity:.5;cursor:wait}
{% endstylesheet %}
