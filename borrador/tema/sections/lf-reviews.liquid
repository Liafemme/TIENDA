{%- comment -%}
  Portada · "Lo que dicen nuestras clientas"
  Arriba, la nota media real de la tienda (Judge.me). Debajo, tarjetas con foto.
  Cada tarjeta se rellena a mano en el editor COPIANDO una reseña real de Judge.me
  (foto que subió la clienta, su nombre, sus estrellas, su texto y el producto).
  No se incluye ninguna reseña de ejemplo: si no hay tarjetas ni reseñas, la sección no se ve.
{%- endcomment -%}
{%- capture rating -%}{% render 'lf-store-rating', style: 'block' %}{%- endcapture -%}
{%- if section.blocks.size > 0 or rating != blank -%}
<section class="lf-section lf-revs" style="background:{{ section.settings.bg }}">
  <div class="lf-wrap">
    <div class="lf-head">
      {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="lf-title">{{ section.settings.heading }}</h2>
      {{ rating }}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="lf-revs__track">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          <article class="lf-rev" {{ block.shopify_attributes }}>
            {%- if bs.image != blank -%}
              <div class="lf-rev__img">{{ bs.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 75vw', alt: bs.name }}</div>
            {%- endif -%}
            <div class="lf-rev__body">
              {% render 'lf-stars', rating: bs.rating, size: 14 %}
              {%- if bs.text != blank -%}<p class="lf-rev__txt">“{{ bs.text }}”</p>{%- endif -%}
              <p class="lf-rev__who">
                <strong>{{ bs.name }}</strong>{% if bs.city != blank %} · {{ bs.city }}{% endif %}
                {%- if bs.verified -%}<span class="lf-rev__ok">{% render 'lf-icon', icon: 'check', size: 13 %} Compra verificada</span>{%- endif -%}
              </p>
              {%- if bs.product != blank -%}
                <a class="lf-rev__prod" href="{{ bs.product.url }}">{{ bs.product.title }} →</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.link != blank and section.settings.link_text != blank -%}
      <div class="lf-revs__more"><a class="lf-btn lf-btn--outline" href="{{ section.settings.link }}">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div>
</section>
<style>
.lf-revs .lf-srating{justify-content:center}
.lf-revs__track{display:grid;grid-auto-flow:column;grid-auto-columns:78%;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px;-webkit-overflow-scrolling:touch}
@media(min-width:750px){.lf-revs__track{grid-auto-columns:calc((100% - 28px)/3)}}
@media(min-width:990px){.lf-revs__track{grid-auto-columns:calc((100% - 60px)/4);gap:20px}}
.lf-rev{scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;border-radius:var(--lf-radius);overflow:hidden;border:1px solid var(--lf-line)}
.lf-rev__img{aspect-ratio:4/5;background:var(--lf-soft)}
.lf-rev__img img{width:100%;height:100%;object-fit:cover;display:block}
.lf-rev__body{display:grid;gap:8px;padding:16px 16px 18px}
.lf-rev__txt{margin:0;font-size:14px;line-height:1.55;color:var(--lf-ink)}
.lf-rev__who{margin:0;font-size:12px;color:var(--lf-muted);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center}
.lf-rev__who strong{color:var(--lf-ink);font-weight:600}
.lf-rev__ok{display:inline-flex;align-items:center;gap:3px;color:#3f7a4f}
.lf-rev__prod{font-size:12px;color:var(--lf-accent);text-decoration:none}
.lf-revs__more{text-align:center;margin-top:28px}
</style>
{%- elsif request.design_mode -%}
  <div class="lf-wrap" style="padding:24px 20px;text-align:center;color:#6b625a;font-size:13px">
    (Solo lo ves tú en el editor) Sección de reseñas: añade tarjetas con reseñas reales de Judge.me. Mientras no haya reseñas ni tarjetas, no se muestra.
  </div>
{%- endif -%}
{% schema %}
{"name":"LF · Reseñas con foto","settings":[
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Reseñas reales"},
{"type":"text","id":"heading","label":"Título","default":"Lo que dicen nuestras clientas"},
{"type":"color","id":"bg","label":"Fondo","default":"#fbf8f4"},
{"type":"text","id":"link_text","label":"Texto del botón","default":"Ver todas las reseñas"},
{"type":"url","id":"link","label":"Enlace del botón","info":"Por ejemplo, la página de reseñas de Judge.me"}],
"blocks":[{"type":"review","name":"Reseña","settings":[
{"type":"paragraph","content":"Copia aquí una reseña REAL de Judge.me, con la foto que subió la clienta."},
{"type":"image_picker","id":"image","label":"Foto de la clienta"},
{"type":"range","id":"rating","label":"Estrellas","min":1,"max":5,"step":1,"default":5},
{"type":"textarea","id":"text","label":"Texto de la reseña"},
{"type":"text","id":"name","label":"Nombre (p. ej. Laura M.)"},
{"type":"text","id":"city","label":"Ciudad (opcional)"},
{"type":"checkbox","id":"verified","label":"Compra verificada en Judge.me","default":true},
{"type":"product","id":"product","label":"Producto que compró"}]}],
"presets":[{"name":"LF · Reseñas con foto"}]}
{% endschema %}
