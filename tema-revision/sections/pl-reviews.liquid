{%- comment -%}
  Opiniones de clientas · rediseño con los colores de la tienda.
  Solo opiniones REALES: añade cada una como bloque (foto, texto, nombre, estrellas).
  Si no hay bloques, la sección no se muestra. La nota media sale de Judge.me (si hay reseñas).
  "Compra verificada" solo aparece si lo marcas en el bloque (úsalo solo si es cierto).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="lf-section pl-rev" style="--pl-rev-bg:{{ section.settings.bg }}">
  <div class="lf-wrap">
    <div class="pl-rev__head">
      <h2 class="pl-rev__title">{{ section.settings.heading }}</h2>
      {% render 'lf-store-rating', style: 'block' %}
    </div>
    <div class="pl-rev__track">
      {%- for block in section.blocks -%}
        <figure class="pl-rev__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}<div class="pl-rev__img">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 75vw', alt: block.settings.name }}</div>{%- endif -%}
          <div class="pl-rev__body">
            {% render 'lf-stars', rating: block.settings.stars, size: 15 %}
            <blockquote>„{{ block.settings.quote }}”</blockquote>
            <figcaption>
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.verified -%}<span class="pl-rev__ver"><svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>Zweryfikowany zakup</span>{%- endif -%}
            </figcaption>
          </div>
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.button != blank -%}
      <div class="pl-rev__cta">
        <a class="pl-rev__btn" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
<style>
.pl-rev{background:var(--pl-rev-bg,#f6f6f6)}
.pl-rev__head{text-align:center;margin-bottom:24px}
.pl-rev__title{margin:0 0 8px;color:#141414;font-size:clamp(22px,3vw,32px);font-weight:800;letter-spacing:-.01em}
.pl-rev .lf-srating{justify-content:center;color:#141414}
.pl-rev .lf-stars__bg{color:#d9d9d9}
.pl-rev .lf-stars__fg{color:#141414}
.pl-rev__track{display:grid;grid-auto-flow:column;grid-auto-columns:75%;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:4px}
.pl-rev__track::-webkit-scrollbar{display:none}
@media(min-width:750px){.pl-rev__track{grid-auto-columns:calc(33.333% - 10px)}}
@media(min-width:990px){.pl-rev__track{grid-auto-columns:calc(25% - 11px)}}
.pl-rev__card{scroll-snap-align:start;margin:0;display:flex;flex-direction:column;background:#fff;border:1px solid #e8e8e8;border-radius:12px;overflow:hidden;transition:border-color .2s,transform .2s}
.pl-rev__card:hover{border-color:#141414;transform:translateY(-2px)}
.pl-rev__img{aspect-ratio:1/1;overflow:hidden;background:#eee}
.pl-rev__img img{width:100%;height:100%;object-fit:cover;display:block}
.pl-rev__body{display:flex;flex-direction:column;gap:10px;padding:16px;flex:1}
.pl-rev__card blockquote{margin:0;font-size:14px;line-height:1.55;color:#333;flex:1}
.pl-rev__card figcaption{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 8px;padding-top:10px;border-top:1px solid #f0f0f0}
.pl-rev__card strong{font-size:13px;color:#141414}
.pl-rev__ver{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#141414}
.pl-rev__cta{text-align:center;margin-top:28px}
.pl-rev__btn{display:inline-block;min-width:240px;padding:15px 32px;background:#141414;color:#fff;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border-radius:4px;transition:background .2s}
.pl-rev__btn:hover,.pl-rev__btn:focus-visible{background:var(--lf-sale,#c40000);color:#fff}
@media(max-width:749px){.pl-rev__btn{display:block;min-width:0}}
</style>
{%- endif -%}
{% schema %}
{"name":"PL · Opiniones","settings":[
{"type":"text","id":"heading","label":"Título","default":"Co mówią nasze klientki"},
{"type":"color","id":"bg","label":"Fondo","default":"#f6f6f6"},
{"type":"text","id":"button","label":"Texto del botón","default":"Zobacz produkty"},
{"type":"url","id":"link","label":"Enlace del botón"}],
"blocks":[{"type":"review","name":"Opinión","settings":[
{"type":"image_picker","id":"image","label":"Foto de la clienta (opcional)"},
{"type":"textarea","id":"quote","label":"Opinión (real)"},
{"type":"text","id":"name","label":"Nombre (p. ej. Anna K.)"},
{"type":"range","id":"stars","label":"Estrellas","min":1,"max":5,"step":1,"default":5},
{"type":"checkbox","id":"verified","label":"Compra verificada (solo si es cierto)","default":false}]}],
"presets":[{"name":"PL · Opiniones"}]}
{% endschema %}
