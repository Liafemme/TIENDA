{%- comment -%}
  Cabecera de la ficha de producto (encima del título, debajo de la foto en móvil):
  ★★★★★ 4,7 de 5 en 23 reseñas (cuadros negros + texto subrayado en Playfair).
  Valores fijos, editables en el bloque (nota media y número de reseñas).
  No depende de apps, CSV ni metacampos: aparece en todos los productos, actuales y futuros.
{%- endcomment -%}
{%- liquid
  assign rating_5 = block.settings.rating | default: 4.7 | times: 1.0
  assign rating_txt = rating_5 | round: 1 | append: '' | replace: '.', ','
  assign rating_txt_short = rating_txt | remove: ',0'
  assign count = block.settings.count | default: 23
-%}
<div class="lf-rh" {{ block.shopify_attributes }}>
  <span class="lf-rh__stars" role="img" aria-label="{{ rating_txt_short }} de 5 estrellas">
    {%- for i in (1..5) -%}
      {%- liquid
        assign prev = i | minus: 1
        assign fill = rating_5 | minus: prev | times: 100 | round
        if fill > 100
          assign fill = 100
        elsif fill < 0
          assign fill = 0
        endif
      -%}
      <span class="lf-rh__box" style="--lf-rh-fill:{{ fill }}%" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 3.6l2.47 5.6 6.1.56-4.62 4.05 1.37 5.97L12 16.65l-5.32 3.13 1.37-5.97L3.43 9.76l6.1-.56z"/></svg>
      </span>
    {%- endfor -%}
  </span>
  <span class="lf-rh__txt">{{ rating_txt_short }} de 5 en {{ count }} {% if count == 1 %}reseña{% else %}reseñas{% endif %}</span>
</div>

{% stylesheet %}
  .lf-rh{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin:0 0 20px}
  .lf-rh__stars{display:inline-flex;gap:2px;line-height:0;flex-shrink:0}
  .lf-rh__box{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;background:linear-gradient(90deg,#1e1a17 var(--lf-rh-fill),#dcdcdc var(--lf-rh-fill))}
  .lf-rh__box svg{width:14px;height:14px;fill:#fff}
  .lf-rh__txt{font-family:var(--font-heading--family,'Playfair Display'),serif;font-size:17px;line-height:1.2;color:#1e1a17;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
  @media (max-width:749px){.lf-rh{gap:12px;margin:0 0 18px}.lf-rh__box{width:21px;height:21px}.lf-rh__box svg{width:16px;height:16px}.lf-rh__txt{font-size:16px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Valoración",
  "tag": null,
  "settings": [
    { "type": "range", "id": "rating", "label": "Nota media (sobre 5)", "min": 1, "max": 5, "step": 0.1, "default": 4.7 },
    { "type": "number", "id": "count", "label": "Número de reseñas", "default": 23, "info": "Actualízalo cuando recibas reseñas nuevas." }
  ],
  "presets": [{ "name": "Valoración" }]
}
{% endschema %}
