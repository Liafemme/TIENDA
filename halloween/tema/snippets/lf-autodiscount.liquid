{%- comment -%}
  Aplica automáticamente un código de descuento (HALLOWEEN10) en el carrito
  y lo anuncia con un popup de Halloween.
  - No se aplica a clientes con sesión iniciada que ya tienen pedidos.
  - El código está limitado a un uso por cliente en Shopify y caduca con la cuenta atrás.
  - Si el carrito tiene 2+ productos, Shopify aplica el descuento automático por cantidad
    (2 prendas -15%, 3 prendas -20%, 4 o más -25%), que sustituye al 10%.
  - El popup sale una vez cada 24 h, nunca en el carrito, y se cierra con la X, el botón o tocando fuera.
{%- endcomment -%}
{%- liquid
  assign code = code | strip
  assign skip = false
  if customer and customer.orders_count > 0
    assign skip = true
  endif
-%}
{%- if code != blank and skip == false -%}
<div class="lf-pop" id="lf-pop" role="dialog" aria-modal="true" aria-labelledby="lf-pop-title" hidden>
  <div class="lf-pop__box">
    <svg class="lf-pop__moon" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="40" fill="#f6c26b"/><circle cx="66" cy="40" r="36" fill="#1a1320"/></svg>
    <svg class="lf-pop__bat lf-pop__bat--1" viewBox="0 0 64 28" aria-hidden="true"><path fill="currentColor" d="M32 10c2-4 4-6 4-6l1 5c4-3 10-4 16-2-3 2-4 5-3 9-4-2-8-1-10 3-3-2-6-3-8-3s-5 1-8 3c-2-4-6-5-10-3 1-4 0-7-3-9 6-2 12-1 16 2l1-5s2 2 4 6z"/></svg>
    <svg class="lf-pop__bat lf-pop__bat--2" viewBox="0 0 64 28" aria-hidden="true"><path fill="currentColor" d="M32 10c2-4 4-6 4-6l1 5c4-3 10-4 16-2-3 2-4 5-3 9-4-2-8-1-10 3-3-2-6-3-8-3s-5 1-8 3c-2-4-6-5-10-3 1-4 0-7-3-9 6-2 12-1 16 2l1-5s2 2 4 6z"/></svg>
    <button type="button" class="lf-pop__x" data-lf-close aria-label="Cerrar">×</button>
    <p class="lf-pop__eyebrow">🎃 Oferta especial de Halloween</p>
    <h2 class="lf-pop__title" id="lf-pop-title">¿Truco o trato?<br><span>Trato: -10% en tu pedido</span></h2>
    <p class="lf-pop__code">Código <strong>{{ code }}</strong> · ya activado</p>
    <p class="lf-pop__txt">Se aplica solo en el carrito, no tienes que copiar nada.<br>Y si te llevas más, ahorras más: <strong>2 prendas -15%, 3 prendas -20% y 4 o más -25%</strong>.</p>
    <div class="lf-pop__cd" data-lf-hw-only>
      <p class="lf-pop__cd-lbl">La oferta desaparece en</p>
      {% render 'lf-hw-countdown' %}
    </div>
    <button type="button" class="lf-pop__btn" data-lf-close>¡Quiero mi trato!</button>
    <p class="lf-pop__small">Envío gratis con seguimiento · 30 días para devoluciones</p>
  </div>
</div>
<style>
.lf-pop{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(12,8,14,.7)}
.lf-pop[hidden]{display:none}
.lf-pop__box{position:relative;overflow:hidden;width:100%;max-width:390px;background:radial-gradient(120% 80% at 50% 0%,#33253b 0%,#1a1320 60%);color:#fbf3ec;border:1px solid rgba(232,119,46,.5);border-radius:16px;padding:32px 24px 22px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(232,119,46,.15);animation:lf-pop-in .35s ease}
@keyframes lf-pop-in{from{transform:translateY(18px);opacity:0}to{transform:none;opacity:1}}
.lf-pop__moon{position:absolute;top:-14px;left:-14px;width:84px;height:84px;opacity:.9;pointer-events:none}
.lf-pop__bat{position:absolute;color:#0d090f;pointer-events:none;animation:lf-bat 3.5s ease-in-out infinite}
.lf-pop__bat--1{top:18px;right:44px;width:34px}
.lf-pop__bat--2{top:46px;right:18px;width:22px;animation-delay:-1.6s;opacity:.85}
@keyframes lf-bat{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-6px) rotate(4deg)}}
@media(prefers-reduced-motion:reduce){.lf-pop__box,.lf-pop__bat{animation:none}}
.lf-pop__x{position:absolute;z-index:1;top:8px;right:10px;background:none;border:0;font-size:26px;line-height:1;color:#fbf3ec;cursor:pointer;padding:6px}
.lf-pop__eyebrow{position:relative;margin:6px 0 8px;font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#f6c26b}
.lf-pop__title{position:relative;margin:0 0 14px;font-family:var(--font-heading--family);font-size:28px;line-height:1.15;font-weight:400;color:#fff}
.lf-pop__title span{color:#e8772e}
.lf-pop__code{display:inline-block;margin:0 0 12px;padding:8px 14px;border:1px dashed #e8772e;border-radius:8px;background:rgba(232,119,46,.12);font-size:14px}
.lf-pop__code strong{color:#f6c26b;letter-spacing:.06em}
.lf-pop__txt{margin:0 0 16px;font-size:14px;line-height:1.5;color:#e4d8dc}
.lf-pop__txt strong{color:#fff}
.lf-pop__cd{margin:0 0 18px}
.lf-pop__cd-lbl{margin:0 0 8px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#f6c26b}
.lf-pop__cd .lf-hw-cd__u{min-width:52px;background:rgba(0,0,0,.35)}
.lf-pop__btn{display:block;width:100%;border:0;border-radius:999px;background:#e8772e;color:#1a1320;font-size:15px;font-weight:700;padding:14px 18px;cursor:pointer;box-shadow:0 6px 20px rgba(232,119,46,.35)}
.lf-pop__btn:hover{background:#f08a45}
.lf-pop__small{margin:12px 0 0;font-size:12px;color:#c9bcc2}
</style>
<script>
(function () {
  var CODE = {{ code | json }};
  var KEY = 'lf_auto_' + CODE;
  function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

  // No aplicar ni mostrar nada cuando la oferta ya ha terminado
  if (window.LF_HW_END && Date.now() >= window.LF_HW_END) return;

  function apply() {
    // 1) Guarda el código en la sesión (se aplica también en el checkout)
    fetch('/discount/' + encodeURIComponent(CODE), { credentials: 'same-origin' }).catch(function () {});
    // 2) Lo añade al carrito para que se vea aplicado
    fetch('/cart/update.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ discount: CODE })
    }).then(function (r) { return r.json(); }).then(function (cart) {
      document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart }));
    }).catch(function () {});
  }

  // Una vez por visita, para no pisar otro código que la clienta escriba después
  var sessionKey = KEY + '_s';
  var done = false;
  try { done = sessionStorage.getItem(sessionKey) === '1'; } catch (e) {}
  if (!done) {
    apply();
    try { sessionStorage.setItem(sessionKey, '1'); } catch (e) {}
  }

  // Popup: una vez cada 24 h y nunca en el carrito
  var pop = document.getElementById('lf-pop');
  if (!pop) return;
  var last = parseInt(read(KEY + '_seen') || '0', 10);
  var isCart = /\/cart(\/|$)/.test(location.pathname);
  if (isCart || Date.now() - last < 24 * 60 * 60 * 1000) return;

  function close() {
    pop.hidden = true;
    document.removeEventListener('keydown', onKey);
  }
  function onKey(e) { if (e.key === 'Escape') close(); }

  pop.addEventListener('click', function (e) {
    if (e.target === pop || e.target.hasAttribute('data-lf-close')) close();
  });

  setTimeout(function () {
    pop.hidden = false;
    store(KEY + '_seen', String(Date.now()));
    document.addEventListener('keydown', onKey);
    var btn = pop.querySelector('.lf-pop__btn');
    if (btn) btn.focus({ preventScroll: true });
  }, 3500);
})();
</script>
{%- endif -%}
