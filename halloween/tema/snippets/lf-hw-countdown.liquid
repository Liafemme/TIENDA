{%- comment -%}
  Cuenta atrás de Halloween en casillas (días · horas · min · seg).
  La rellena el script de snippets/lf-halloween.liquid.
  Uso: {% render 'lf-hw-countdown' %}
{%- endcomment -%}
<div class="lf-hw-cd" data-lf-cd role="timer" aria-label="Tiempo restante de la oferta de Halloween">
  <span class="lf-hw-cd__u"><b data-u="d">0</b><small>días</small></span>
  <span class="lf-hw-cd__sep" aria-hidden="true">:</span>
  <span class="lf-hw-cd__u"><b data-u="h">00</b><small>horas</small></span>
  <span class="lf-hw-cd__sep" aria-hidden="true">:</span>
  <span class="lf-hw-cd__u"><b data-u="m">00</b><small>min</small></span>
  <span class="lf-hw-cd__sep" aria-hidden="true">:</span>
  <span class="lf-hw-cd__u"><b data-u="s">00</b><small>seg</small></span>
</div>
