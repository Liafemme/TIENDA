{%- comment -%}
  Section contract.
  Franja de urgencia de Halloween con cuenta atrás, en el grupo de cabecera.
  Se oculta sola cuando termina la oferta (ver snippets/lf-halloween.liquid).
{%- endcomment -%}
<div class="lf-hwbar" data-lf-hw-only>
  <a class="lf-hwbar__in" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
    <span class="lf-hwbar__txt"><span aria-hidden="true">🎃</span> {{ section.settings.text | escape }}</span>
    <span class="lf-hwbar__time"><span data-lf-cd>--:--:--</span></span>
    {%- if section.settings.cta != blank -%}<span class="lf-hwbar__cta">{{ section.settings.cta | escape }} →</span>{%- endif -%}
  </a>
</div>
<style>
  .lf-hwbar{background:linear-gradient(90deg,#1a1320 0%,#2a1f30 50%,#1a1320 100%);color:#fbf3ec;border-bottom:1px solid rgba(232,119,46,.35)}
  .lf-hwbar__in{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px 12px;max-width:1320px;margin:0 auto;padding:8px 16px;color:inherit;text-decoration:none;font-size:12px;letter-spacing:.06em;text-align:center}
  .lf-hwbar__txt{text-transform:uppercase;font-weight:600}
  .lf-hwbar__time{display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;background:#e8772e;color:#1a1320;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:.04em}
  .lf-hwbar__cta{color:#f6c26b;text-decoration:underline;text-underline-offset:3px;font-weight:600}
  @media(max-width:749px){.lf-hwbar__cta{display:none}.lf-hwbar__in{flex-wrap:nowrap;gap:8px;padding:7px 10px;font-size:10.5px;letter-spacing:.02em;white-space:nowrap}.lf-hwbar__time{padding:2px 8px}}
</style>
{% schema %}
{
  "name": "LF · Cuenta Halloween",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Ofertas de Halloween · terminan en" },
    { "type": "text", "id": "cta", "label": "Texto del enlace", "default": "Comprar ya" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "presets": [{ "name": "LF · Cuenta Halloween" }]
}
{% endschema %}
