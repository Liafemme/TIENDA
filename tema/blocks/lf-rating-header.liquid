{%- comment -%}
  Estrellas + "4,7 de 5 · 23 reseñas" encima del título del producto.
  Usa las reseñas reales de Judge.me (metacampos reviews.rating / reviews.rating_count).
  Si el producto aún no tiene reseñas, no se muestra nada.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign rating = product.metafields.reviews.rating.value.rating
  assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank and rating_count > 0 -%}
  {%- liquid
    assign rating_5 = rating | times: 5.0 | divided_by: scale_max
    assign rating_txt = rating_5 | round: 1 | append: '' | replace: '.', ','
  -%}
  <div class="lf-rh" {{ block.shopify_attributes }}>
    <span class="lf-rh__stars" role="img" aria-label="{{ rating_txt }} de 5 estrellas">
      {%- for i in (1..5) -%}
        {%- liquid
          assign prev = i | minus: 1
          assign fill = rating_5 | minus: prev | times: 100 | round
          if fill > 100
            assign fill = 100
          elsif fill < 0
            assign fill = 0
          endif
        -%}
        <span class="lf-rh__box" style="--lf-rh-fill:{{ fill }}%" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3.6l2.47 5.6 6.1.56-4.62 4.05 1.37 5.97L12 16.65l-5.32 3.13 1.37-5.97L3.43 9.76l6.1-.56z"/></svg>
        </span>
      {%- endfor -%}
    </span>
    <a class="lf-rh__txt" href="#judgeme_product_reviews">{{ rating_txt }} de 5 · {{ rating_count }} {% if rating_count == 1 %}reseña{% else %}reseñas{% endif %}</a>
  </div>
{%- endif -%}

{% stylesheet %}
  .lf-rh{display:flex;align-items:center;gap:16px;margin:0 0 20px}
  .lf-rh__stars{display:inline-flex;gap:2px;line-height:0}
  .lf-rh__box{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;background:linear-gradient(90deg,#1e1a17 var(--lf-rh-fill),#dcdcdc var(--lf-rh-fill))}
  .lf-rh__box svg{width:14px;height:14px;fill:#fff}
  .lf-rh__txt{font-family:var(--font-heading--family,'Playfair Display'),serif;font-size:17px;line-height:1.2;color:#1e1a17;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1px}
  .lf-rh__txt:hover{opacity:.75}
  @media (max-width:749px){.lf-rh{gap:16px;margin:0 0 18px}.lf-rh__box{width:21px;height:21px}.lf-rh__box svg{width:16px;height:16px}.lf-rh__txt{font-size:19px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Estrellas reseñas",
  "tag": null,
  "settings": [],
  "presets": [{ "name": "Estrellas reseñas" }]
}
{% endschema %}
