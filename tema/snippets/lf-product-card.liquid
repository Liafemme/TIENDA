{%- liquid
  assign p = product
  assign img1 = p.featured_image
  assign img2 = p.images[1]
  assign off = 0
  if p.compare_at_price > p.price
    assign off = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
  endif
-%}
<article class="lf-card">
  <a href="{{ p.url }}" class="lf-card__media" aria-label="{{ p.title | escape }}">
    {%- if img1 -%}
      {{ img1 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(min-width: 990px) 25vw, 50vw', class: 'lf-card__img', alt: p.title }}
      {%- if img2 -%}{{ img2 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(min-width: 990px) 25vw, 50vw', class: 'lf-card__img lf-card__img--2', alt: p.title }}{%- endif -%}
    {%- endif -%}
    {%- if p.available == false -%}<span class="lf-card__badge lf-card__badge--out">Agotado</span>
    {%- elsif off > 0 -%}<span class="lf-card__badge">-{{ off }}%</span>{%- endif -%}
  </a>
  <div class="lf-card__info">
    <a href="{{ p.url }}" class="lf-card__title">{{ p.title }}</a>
    <div class="lf-card__price">
      <span class="lf-card__now{% if off > 0 %} is-sale{% endif %}">{{ p.price | money }}</span>
      {%- if off > 0 -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
    </div>
    {% render 'lf-card-offer', p: p %}
    {%- assign colors = p.options_with_values | where: 'name', 'Color' | first -%}
    {%- if colors and colors.values.size > 1 -%}<span class="lf-card__meta">{{ colors.values.size }} colores</span>{%- endif -%}
  </div>
</article>
