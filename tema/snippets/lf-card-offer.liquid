{%- comment -%}
  Línea pequeña bajo el precio de las tarjetas de producto con el precio final del código de bienvenida.
  Uso: {% render 'lf-card-offer', p: product %}
  Debe coincidir con el descuento BIENVENIDA15 (15%) y "Compra 2 y ahorra 20%" de Shopify.
{%- endcomment -%}
{%- liquid
  assign welcome = true
  if customer and customer.orders_count > 0
    assign welcome = false
  endif
  assign cents = p.price
-%}
{%- if p and p.available -%}
  {%- if welcome -%}
    <p class="lf-cardoff">Con tu 15%: <strong>{{ cents | times: 0.85 | round | money }}</strong></p>
  {%- else -%}
    <p class="lf-cardoff">Llévate 2: <strong>-20%</strong></p>
  {%- endif -%}
  <style>
    .lf-cardoff{margin:4px 0 0;font-size:12px;line-height:1.3;color:#4a433d}
    .lf-cardoff strong{color:#a23b2c;font-weight:700}
  </style>
{%- endif -%}
