{%- comment -%}
  LF · Selector de piedras (2 piedras obligatorias).
  Se muestra en productos con la etiqueta "selector-piedras" (desde blocks/variant-picker.liquid).
  Guarda la elección como propiedades del artículo "Piedra 1" y "Piedra 2" y bloquea
  "Añadir al carrito" / compra rápida hasta que se elijan las 2 piedras.
  "scene" (solo Liora): foto real del collar con las piedras elegidas encima; coordenadas medidas sobre sus fotos.
  Para cambiar piedras, edita la lista "stones" (nombre, color, subtítulo, foto en Contenido > Archivos).
{%- endcomment -%}
{{ 'lf-piedras.css' | asset_url | stylesheet_tag }}
<lf-piedras class="lf-pz" data-form-id="BuyButtons-ProductForm-{{ section.id }}" data-prop1="Piedra 1" data-prop2="Piedra 2">
  <button type="button" class="lf-pz__trigger" data-pz-open>
    <span class="lf-pz__left">
      <span class="lf-pz__plus" aria-hidden="true">+</span>
      <span>Elige tus piedras</span>
      <span class="lf-pz__muted">(Gratis)</span>
    </span>
    <span class="lf-pz__chips" data-pz-chips></span>
    <span class="lf-pz__count" data-pz-count>0/2</span>
  </button>
  <p class="lf-pz__need" data-pz-need hidden>Elige 2 piedras para añadir al carrito</p>
  <script type="application/json" data-pz-config>
    {
      "title": "Elige una piedra",
      "stone1": "Piedra 1",
      "stone2": "Piedra 2",
      "confirm": "Confirmar",
      "err": "Selecciona una piedra",
      {%- if product.handle == 'liora-collar' %}
      "scene": {
        "oro": {"base": {{ 'lf-liora-base-oro.webp' | file_url | json }}, "top": {{ 'lf-liora-top-oro.webp' | file_url | json }}, "w": 800, "h": 550,
          "slots": [[321.5, 352.5, 144.6, 0.78], [460, 353.5, -143.6, 0.78]],
          "refl": {"y": 460, "bg": "#f9f6f1", "x0": 240, "x1": 570},
          "photo": "ChatGPT_Image_11_aug_2026_15_47_22", "full": [1792, 2400], "ox": 500, "oy": 1500, "k": 1},
        "plata": {"base": {{ 'lf-liora-base-plata.webp' | file_url | json }}, "top": {{ 'lf-liora-top-plata.webp' | file_url | json }}, "w": 800, "h": 550,
          "slots": [[317, 368, 147, 0.77], [451, 370, -144.4, 0.78]],
          "refl": {"y": 478, "bg": "#f6f7f6", "x0": 240, "x1": 570},
          "photo": "ChatGPT_Image_11_aug_2026_15_52_10", "full": [1254, 1254], "ox": 440, "oy": 780, "k": 0.5}
      },
      {%- endif %}
      "stones": [
        {"name": "Enero", "color": "#8e1b2e", "sub": "Granate", "img": {{ 'lf-piedra-enero.webp' | file_url | json }}},
        {"name": "Febrero", "color": "#8f5fc4", "sub": "Amatista", "img": {{ 'lf-piedra-febrero.webp' | file_url | json }}},
        {"name": "Marzo", "color": "#86d3e3", "sub": "Aguamarina", "img": {{ 'lf-piedra-marzo.webp' | file_url | json }}},
        {"name": "Abril", "color": "#eef3f6", "sub": "Diamante", "img": {{ 'lf-piedra-abril.webp' | file_url | json }}},
        {"name": "Mayo", "color": "#1d9a5b", "sub": "Esmeralda", "img": {{ 'lf-piedra-mayo.webp' | file_url | json }}},
        {"name": "Junio", "color": "#d9c8e6", "sub": "Alejandrita", "img": {{ 'lf-piedra-junio.webp' | file_url | json }}},
        {"name": "Julio", "color": "#cf1340", "sub": "Rubí", "img": {{ 'lf-piedra-julio.webp' | file_url | json }}},
        {"name": "Agosto", "color": "#a5c43a", "sub": "Peridoto", "img": {{ 'lf-piedra-agosto.webp' | file_url | json }}},
        {"name": "Septiembre", "color": "#1f4fbf", "sub": "Zafiro", "img": {{ 'lf-piedra-septiembre.webp' | file_url | json }}},
        {"name": "Octubre", "color": "#f08ab6", "sub": "Turmalina", "img": {{ 'lf-piedra-octubre.webp' | file_url | json }}},
        {"name": "Noviembre", "color": "#f0a11d", "sub": "Topacio", "img": {{ 'lf-piedra-noviembre.webp' | file_url | json }}},
        {"name": "Diciembre", "color": "#3aa6d8", "sub": "Circón", "img": {{ 'lf-piedra-diciembre.webp' | file_url | json }}}
      ]
    }
  </script>
</lf-piedras>
<script src="{{ 'lf-piedras.js' | asset_url }}" defer></script>
