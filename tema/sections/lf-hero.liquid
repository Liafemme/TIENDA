{%- liquid
  assign c = section.settings.collection
  assign i1 = section.settings.image_1 | default: c.products[0].featured_image
  assign i2 = section.settings.image_2 | default: c.products[1].featured_image
  assign i3 = section.settings.image_3 | default: c.products[2].featured_image
  assign brand = section.settings.brand_text | default: shop.name
  assign brand_alpha = section.settings.brand_opacity | divided_by: 100.0
-%}
<section class="lf-hero lf-hero--brand-{{ section.settings.brand_position }}" style="--lf-brand-alpha: {{ brand_alpha }};">
  <div class="lf-hero__media">
    {%- for img in (1..3) -%}
      {%- case forloop.index -%}{%- when 1 -%}{%- assign im = i1 -%}{%- when 2 -%}{%- assign im = i2 -%}{%- else -%}{%- assign im = i3 -%}{%- endcase -%}
      {%- if im -%}<div class="lf-hero__tile lf-hero__tile--{{ forloop.index }}">{{ im | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500,800,1100,1400', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}</div>{%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.show_brand and brand != blank -%}
    <div class="lf-hero__brand" aria-hidden="true">
      <span class="lf-hero__brand-word">{{ brand }}</span>
      {%- if section.settings.brand_tagline != blank -%}<span class="lf-hero__brand-tag">{{ section.settings.brand_tagline }}</span>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="lf-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="lf-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="lf-hero__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="lf-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="lf-hero__btns">
      {%- if section.settings.btn1 != blank -%}<a class="lf-btn lf-btn--light" href="{{ section.settings.link1 | default: c.url }}">{{ section.settings.btn1 }}</a>{%- endif -%}
      {%- if section.settings.btn2 != blank -%}<a class="lf-btn lf-btn--ghost" href="{{ section.settings.link2 }}">{{ section.settings.btn2 }}</a>{%- endif -%}
    </div>
  </div>
</section>
<style>
.lf-hero{position:relative;color:#fff;overflow:hidden;background:#2a2420}
.lf-hero__media{display:grid;grid-template-columns:1fr;height:min(82svh,760px)}
.lf-hero__tile{position:relative;overflow:hidden}
.lf-hero__tile img{width:100%;height:100%;object-fit:cover;display:block}
.lf-hero__tile--2,.lf-hero__tile--3{display:none}
@media(min-width:750px){.lf-hero__media{grid-template-columns:repeat(3,1fr);height:min(86vh,820px)}.lf-hero__tile--2,.lf-hero__tile--3{display:block}}
.lf-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.18) 0%,rgba(0,0,0,.06) 35%,rgba(0,0,0,.6) 100%);pointer-events:none;z-index:1}

/* Marca de fondo: grande, translúcida, detrás del texto */
.lf-hero__brand{position:absolute;z-index:1;left:0;right:0;display:flex;flex-direction:column;align-items:center;pointer-events:none;user-select:none;text-align:center;animation:lf-brand-in 1.2s ease-out both}
.lf-hero--brand-top .lf-hero__brand{top:7%}
.lf-hero--brand-center .lf-hero__brand{top:50%;transform:translateY(-62%)}
.lf-hero__brand-word{display:block;white-space:nowrap;font-family:var(--font-heading--family);font-weight:400;text-transform:uppercase;letter-spacing:.06em;line-height:.9;font-size:clamp(46px,14vw,250px);color:rgba(255,255,255,var(--lf-brand-alpha,.3));text-shadow:0 2px 40px rgba(0,0,0,.12)}
.lf-hero__brand-tag{display:block;margin-top:clamp(8px,1.2vw,18px);font-size:clamp(9px,1vw,13px);letter-spacing:.5em;text-transform:uppercase;padding-left:.5em;color:rgba(255,255,255,calc(var(--lf-brand-alpha,.3) + .35))}
@keyframes lf-brand-in{from{opacity:0;letter-spacing:.12em}to{opacity:1}}
@media(prefers-reduced-motion:reduce){.lf-hero__brand{animation:none}}

.lf-hero__content{position:absolute;z-index:2;left:0;right:0;bottom:0;padding:0 22px 48px;text-align:center}
@media(min-width:750px){.lf-hero__content{padding-bottom:72px}}
.lf-hero__eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;margin:0 0 14px;opacity:.95}
.lf-hero__title{font-family:var(--font-heading--family);font-weight:400;font-size:clamp(36px,6vw,72px);line-height:1.02;margin:0 auto 14px;max-width:900px;color:#fff}
.lf-hero__text{font-size:15px;line-height:1.55;max-width:520px;margin:0 auto 26px;opacity:.95}
.lf-hero__btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
</style>
{% schema %}
{"name":"LF · Portada (hero)","settings":[
{"type":"collection","id":"collection","label":"Colección (fotos y enlace)"},
{"type":"image_picker","id":"image_1","label":"Imagen 1 (móvil y escritorio)"},
{"type":"image_picker","id":"image_2","label":"Imagen 2 (escritorio)"},
{"type":"image_picker","id":"image_3","label":"Imagen 3 (escritorio)"},
{"type":"header","content":"Marca de fondo"},
{"type":"checkbox","id":"show_brand","label":"Mostrar nombre de la marca de fondo","default":true},
{"type":"text","id":"brand_text","label":"Texto de la marca","info":"Vacío = nombre de la tienda","default":"Lia Femme"},
{"type":"text","id":"brand_tagline","label":"Línea pequeña bajo la marca","default":"Moda femenina"},
{"type":"range","id":"brand_opacity","label":"Opacidad de la marca","min":10,"max":70,"step":2,"unit":"%","default":30},
{"type":"select","id":"brand_position","label":"Posición de la marca","options":[{"value":"top","label":"Arriba"},{"value":"center","label":"Centro"}],"default":"top"},
{"type":"header","content":"Texto"},
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Nueva colección"},
{"type":"text","id":"heading","label":"Título","default":"Otoño 2026"},
{"type":"text","id":"text","label":"Texto"},
{"type":"text","id":"btn1","label":"Botón 1","default":"Comprar ahora"},
{"type":"url","id":"link1","label":"Enlace botón 1"},
{"type":"text","id":"btn2","label":"Botón 2"},
{"type":"url","id":"link2","label":"Enlace botón 2"}
],"presets":[{"name":"LF · Portada (hero)"}]}
{% endschema %}
