<section class="lf-section lf-guar">
  <div class="lf-wrap">
    <div class="lf-head">
      {%- if section.settings.eyebrow != blank -%}<p class="lf-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="lf-title">{{ section.settings.heading }}</h2>
    </div>
    <div class="lf-guar__grid">
      {%- for block in section.blocks -%}
        <div class="lf-guar__item" {{ block.shopify_attributes }}>
          <span class="lf-guar__ic">{% render 'lf-icon', icon: block.settings.icon, size: 30 %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
.lf-guar{background:var(--lf-soft)}
.lf-guar__grid{display:grid;gap:14px}
@media(min-width:750px){.lf-guar__grid{grid-template-columns:repeat({{ section.blocks.size | at_most: 4 }},1fr);gap:20px}}
.lf-guar__item{background:#fff;border-radius:var(--lf-radius);padding:28px 24px;text-align:center}
.lf-guar__ic{display:inline-flex;width:58px;height:58px;border-radius:50%;align-items:center;justify-content:center;background:var(--lf-soft);color:var(--lf-accent);margin-bottom:14px}
.lf-guar__item h3{font-family:var(--font-heading--family);font-weight:400;font-size:20px;margin:0 0 8px}
.lf-guar__item p{color:var(--lf-muted);font-size:14px;line-height:1.6;margin:0}
</style>
{% schema %}
{"name":"LF · Garantías","settings":[
{"type":"text","id":"eyebrow","label":"Antetítulo","default":"Compra sin riesgo"},
{"type":"text","id":"heading","label":"Título","default":"Por qué comprar en Zofia Nowak"}],
"blocks":[{"type":"item","name":"Garantía","settings":[
{"type":"select","id":"icon","label":"Icono","options":[{"value":"truck","label":"Envío"},{"value":"return","label":"Devolución"},{"value":"lock","label":"Pago seguro"},{"value":"chat","label":"Atención"},{"value":"star","label":"Estrella"},{"value":"leaf","label":"Calidad"},{"value":"ruler","label":"Tallas"},{"value":"gift","label":"Regalo"}],"default":"truck"},
{"type":"text","id":"title","label":"Título"},
{"type":"textarea","id":"text","label":"Texto"}]}],
"presets":[{"name":"LF · Garantías"}]}
{% endschema %}
