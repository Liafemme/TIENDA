                {% if stars_icon != blank %}
                  {%- assign sc_floor = sc | floor -%}
                  {%- assign sc_ceil = sc | ceil -%}
                  {%- assign sc_has_half = false -%}
                  {%- if sc != sc_floor -%}{%- assign sc_has_half = true -%}{%- endif -%}
                  {% for i in (1..5) %}
                    {%- if i <= sc_floor -%}
                      <img
                        src="{{ stars_icon | image_url: width: star_image_width }}"
                        alt="{{ stars_icon.alt }}"
                        width="{{ stars_size }}"
                        height="{{ stars_size }}"
                      >
                    {%- elsif sc_has_half and i == sc_ceil -%}
                      {%- if stars_icon_half != blank -%}
                        <img
                          src="{{ stars_icon_half | image_url: width: star_image_width }}"
                          alt="{{ stars_icon_half.alt }}"
                          width="{{ stars_size }}"
                          height="{{ stars_size }}"
                        >
                      {%- else -%}
                        <img
                          src="{{ stars_icon | image_url: width: star_image_width }}"
                          alt="{{ stars_icon.alt }}"
                          width="{{ stars_size }}"
                          height="{{ stars_size }}"
                        >
                      {%- endif -%}
                    {%- else -%}
                      {%- if stars_icon_empty != blank -%}
                        <img
                          src="{{ stars_icon_empty | image_url: width: star_image_width }}"
                          alt="{{ stars_icon_empty.alt }}"
                          width="{{ stars_size }}"
                          height="{{ stars_size }}"
