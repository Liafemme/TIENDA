              <span class="tst-sr-only-{{ section.id }}">Rated {{ sc }} out of 5 stars</span>
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <p class="tst-card-title-{{ section.id }}">{{ block.settings.title }}</p>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="tst-card-text-{{ section.id }}">{{ block.settings.text }}</div>
          {% endif %}

          {% if block.settings.author != blank or block.settings.date != blank %}
            <div class="tst-card-footer-{{ section.id }}">
              {% if block.settings.author != blank %}
                <p class="tst-card-author-{{ section.id }}">{{ block.settings.author }}</p>
              {% endif %}
              {% if block.settings.author != blank and block.settings.date != blank %}
