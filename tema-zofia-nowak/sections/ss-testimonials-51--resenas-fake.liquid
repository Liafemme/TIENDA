                    <rect width="32" height="32" fill="{% if sc == 4.5 %}url(#grad{{ section.id }}-{{ block.id }}-5){% elsif sc >= 5 %}{{ stars_bg_color }}{% else %}{{ stars_bg_half_color }}{% endif %}"/>
