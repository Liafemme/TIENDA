                    {% if sc == 2.5 %}<defs><linearGradient id="grad{{ section.id }}-{{ block.id }}-3"><stop offset="0%" stop-color="{{ stars_bg_color }}" /><stop offset="50%" stop-color="{{ stars_bg_color }}" /><stop offset="50%" stop-color="{{ stars_bg_half_color }}" /><stop offset="100%" stop-color="{{ stars_bg_half_color }}" /></linearGradient></defs>{% endif %}
                    <rect width="32" height="32" fill="{% if sc == 2.5 %}url(#grad{{ section.id }}-{{ block.id }}-3){% elsif sc >= 3 %}{{ stars_bg_color }}{% else %}{{ stars_bg_half_color }}{% endif %}"/>
                    <g clip-path="url(#clip{{ section.id }}_{{ block.id }}_3)"><path d="M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z" fill="{{ stars_color }}"/></g><defs><clipPath id="clip{{ section.id }}_{{ block.id }}_3"><rect width="22" height="22" fill="{{ stars_color }}" transform="translate(5 5)"/></clipPath></defs>
