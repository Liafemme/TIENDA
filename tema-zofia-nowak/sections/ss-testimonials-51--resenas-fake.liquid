                    <rect width="32" height="32" fill="{% if sc == 1.5 %}url(#grad{{ section.id }}-{{ block.id }}-2){% elsif sc >= 2 %}{{ stars_bg_color }}{% else %}{{ stars_bg_half_color }}{% endif %}"/>
