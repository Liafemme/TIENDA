      <div class="tst-load-more-wrap-{{ section.id }}">
        <button
          type="button"
          class="tst-load-more-btn-{{ section.id }}"
          aria-expanded="false"
          aria-controls="tst-grid-{{ section.id }}"
        >
          {{ load_more_text }}
        </button>
      </div>
    {% endif %}
  </div>
</div>

<script>
  function initTestimonials51() {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section || section.dataset.tstInit) return;
    section.dataset.tstInit = '1';

    const btn = section.querySelector('.tst-load-more-btn-{{ section.id }}');
    if (!btn) return;

    let expanded = false;

    btn.addEventListener('click', () => {
      expanded = !expanded;
      section.classList.toggle('tst-collapsed-{{ section.id }}', !expanded);
      btn.textContent = expanded ? {{ load_less_text | json }} : {{ load_more_text | json }};
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });
  }

  document.addEventListener('DOMContentLoaded', initTestimonials51);
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:unload', initTestimonials51);
    document.addEventListener('shopify:section:load', initTestimonials51);
  }
</script>

