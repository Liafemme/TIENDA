{%- comment -%}
  Línea de confianza como bloque suelto (para usar desde el editor de temas).
{%- endcomment -%}
<div {{ block.shopify_attributes }}>{% render 'lf-trust-line', text: block.settings.text, link: block.settings.link %}</div>

{% schema %}
{
  "name": "Línea de confianza",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis · 30 días para devolver" },
    { "type": "url", "id": "link", "label": "Enlace", "info": "Si lo dejas vacío, enlaza a la política de envíos." }
  ],
  "presets": [{ "name": "Línea de confianza" }]
}
{% endschema %}
