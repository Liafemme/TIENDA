    "faq": {
      "type": "lf-faq",
      "blocks": {
        "q1": { "type": "qa", "settings": { "q": "¿Cómo se aplican los descuentos por cantidad?", "a": "<p>Solos. Añade 2 prendas al carrito y verás un -15% extra; con 3, un -20%; con 4 o más, un -25%. Se aplican sobre el precio ya rebajado de la liquidación y no necesitas ningún código.</p>" } },
        "q2": { "type": "qa", "settings": { "q": "¿Hasta cuándo dura la liquidación?", "a": "<p>Hasta el 31 de octubre a medianoche (hora peninsular) o hasta agotar existencias. Las unidades de cada talla son limitadas y no se reponen.</p>" } },
        "q3": { "type": "qa", "settings": { "q": "¿Cuánto tarda el envío?", "a": "<p>El envío es gratis y con seguimiento. Preparamos tu pedido en 1-3 días laborables y la entrega en España y la UE tarda normalmente 7-14 días laborables.</p>" } },
        "q4": { "type": "qa", "settings": { "q": "¿Y si no me queda bien?", "a": "<p>Tienes 30 días naturales desde que recibes el pedido para devolverlo. Escríbenos y te explicamos cómo hacerlo.</p>" } }
      },
      "block_order": ["q1", "q2", "q3", "q4"],
      "settings": {
        "eyebrow": "Ayuda",
        "heading": "Preguntas frecuentes",
        "contact": "¿Más dudas? Escríbenos a <a href=\"mailto:liafemme23@gmail.com\">liafemme23@gmail.com</a> y te respondemos en menos de 24 h."
      }
    }
