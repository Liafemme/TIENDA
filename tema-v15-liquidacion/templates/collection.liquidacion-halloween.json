      "type": "lf-guarantee",
      "blocks": {
        "g1": { "type": "item", "settings": { "icon": "truck", "title": "Envío gratis con seguimiento", "text": "Preparamos tu pedido en 1-3 días laborables y te enviamos el número de seguimiento para que sepas en todo momento dónde está." } },
        "g2": { "type": "item", "settings": { "icon": "lock", "title": "Pago 100% seguro", "text": "Tarjeta, Apple Pay y Google Pay con cifrado SSL. Nunca vemos ni guardamos los datos de tu tarjeta." } },
        "g3": { "type": "item", "settings": { "icon": "return", "title": "30 días para devolverlo", "text": "Si algo no te convence, tienes 30 días desde que lo recibes para devolverlo, sin dar explicaciones." } }
